# Uploaded files are only ever served as static files, never executed.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php\d?|phtml|phar)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes -ExecCGI
